# Production environment for the Velorki website + relay (web/).
#
# Two ways to give these to the process, both described in docs/DEPLOY_WEB.md:
#
#   a) Orkify dashboard → Settings → Secrets, scoped to the project. The agent
#      injects them into the managed processes on its next heartbeat and they
#      take precedence over the `env:` block in web/orkify.yml. This is the
#      right home for everything marked SECRET below.
#      https://orkify.com/docs/secrets
#   b) A file on the box, e.g. /etc/velorki/web.env, owned by the service user
#      and chmod 0600, loaded with
#        nodeArgs: ['--env-file=/etc/velorki/web.env']
#      in web/orkify.yml (Node 20.6+ reads it natively), or /etc/orkify/env,
#      which `orkify autostart`'s systemd unit loads for every managed process.
#
# NEVER commit the filled-in version. The repo only ever holds this template.
# What is already in web/orkify.yml (NODE_ENV, PORT, HOSTNAME, SHARE_DB_PATH)
# is repeated here only where a value differs.

# ---------------------------------------------------------------- server ----

# Port and bind address. Must match `port:` in web/orkify.yml; Caddy proxies to
# 127.0.0.1:8080.
PORT=8080
HOSTNAME=0.0.0.0

# pino level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Reported by GET /health as `version`. Set it to the deployed tag.
APP_VERSION=web-v1.0.0

# ----------------------------------------------------------------- hosts ----

# The two public hostnames. The app routes by Host: anything that is neither of
# these (nor the loopback host the Orkify health probe uses) gets a 404, so a
# stray name pointed at this box cannot reach a handler.
API_HOST=api.velorki.com
SITE_HOST=velorki.com

# Origin used to build share links (`${PUBLIC_BASE_URL}/s/<id>`), no trailing
# slash. Share pages live on the SITE host now, not on the API host.
PUBLIC_BASE_URL=https://velorki.com

# Absolute origin for canonical URLs, sitemap and Open Graph tags. Compiled
# into the client bundle by Next (NEXT_PUBLIC_*), so it is public by design.
# Build-time: it must be present for `deploy.build` in web/orkify.yml, and
# changing it later does nothing until the next build.
NEXT_PUBLIC_SITE_URL=https://velorki.com

# Store listing URLs for the download page and the badges. Build-time, like
# the line above. Leave empty until the listing exists - a badge with no URL is
# left out of the markup rather than rendered as a dead link.
NEXT_PUBLIC_STORE_URL_IOS=
NEXT_PUBLIC_STORE_URL_ANDROID=

# ----------------------------------------------------------------- proxy ----

# Caddy terminates TLS and is the only thing that talks to the app.
TRUST_PROXY=1

# Where the client's address comes from. Cloudflare sets CF-Connecting-IP and
# Caddy re-emits it after checking the request really came from a Cloudflare
# range (deploy/web/Caddyfile + cloudflare-ips.sh), so it cannot be forged.
# X-Forwarded-For would be the wrong choice here: Cloudflare appends to it.
CLIENT_IP_HEADER=cf-connecting-ip

# ---------------------------------------------------------- cluster state ----

# Cross-worker counters: rate-limit windows, the entitlement cache and the
# daily LLM budget. `orkify` = @orkify/cache, shared across the cluster.
# `memory` is per-worker and only correct for local development and tests.
COUNTERS=orkify

# Next.js deployment id: sent with every asset request and checked by the
# server, so a browser holding an old page never mixes chunks from two
# releases. Set it per deploy - the CI workflow passes the git SHA.
NEXT_DEPLOYMENT_ID=

# ---------------------------------------------------------------- routing ----

# Base URL of a BRouter instance, no trailing slash. Only used by the /health
# probe; the app talks to BRouter directly.
BROUTER_URL=https://brouter.velorki.com

# ------------------------------------------------------------------ OAuth ----

# SECRET. Strava API application (https://www.strava.com/settings/api).
# Unset → /oauth/strava/* returns 503 unavailable.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# SECRET. Ride with GPS API credentials. Unset → /oauth/rwgps/* → 503.
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=

# Comma-separated list of redirect URIs the app may use. Exact match, no
# prefixes, no wildcards. An empty list rejects every token exchange.
OAUTH_REDIRECT_ALLOWLIST=velorki://oauth/strava,velorki://oauth/rwgps

# ------------------------------------------------------------ entitlement ----

# SECRET. RevenueCat v1 secret API key. Required when REVENUECAT_MODE=live.
REVENUECAT_SECRET_KEY=

# Entitlement identifier to look for on the subscriber.
REVENUECAT_ENTITLEMENT=plus

# live | stub. `stub` makes everyone entitled - correct for a fork or local
# development, wrong for anything public. The official box runs `live`.
REVENUECAT_MODE=live

# -------------------------------------------------------------------- LLM ----

# Any OpenAI-compatible chat completions endpoint (the /v1 root).
# Unset → /ai/plan returns 503 and /health reports llm: "unconfigured".
LLM_BASE_URL=

# SECRET. Sent as `Authorization: Bearer <key>`.
LLM_API_KEY=

# Model identifier as the endpoint knows it.
LLM_MODEL=

# Coarse circuit breaker on spend, USD per UTC day, counted across the cluster
# through COUNTERS. The hard ceiling belongs at the provider as well. Setting
# it requires both prices below to be greater than 0, or the app refuses to
# start: with no prices the estimated spend is 0 and the budget never applies.
LLM_DAILY_BUDGET_USD=

# Token prices used to estimate that spend, USD per 1000 tokens.
LLM_USD_PER_1K_IN=0
LLM_USD_PER_1K_OUT=0

# ------------------------------------------------------------------ share ----

# SQLite file for shared routes and rides (node:sqlite, WAL). Absolute, outside
# the release tree, on a persistent disk: a relative path would hand out links
# that break on the next deploy. Directory 0700, owned by the service user.
SHARE_DB_PATH=/var/lib/velorki/share.sqlite

# --------------------------------------------------- app links (.well-known) ---

# Served in /.well-known/apple-app-site-association and assetlinks.json so
# https://velorki.com/s/<id> opens the app instead of the browser.
# Apple Developer team id that signs the iOS app (the app id is
# <APPLE_TEAM_ID>.com.orkitec.velorki).
APPLE_TEAM_ID=
# SHA-256 fingerprint of the Android signing certificate, upper-case hex with
# colons. From the upload/play signing key:
#   keytool -list -v -keystore upload.jks -alias <alias> | grep 'SHA256:'
ANDROID_CERT_SHA256=
