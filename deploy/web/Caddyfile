# Velorki website + relay: the TLS terminator in front of the Orkify cluster.
#
# Install to /etc/caddy/Caddyfile. Full runbook: docs/DEPLOY_WEB.md.
#
# Three hostnames, one origin process on 127.0.0.1:8080:
#   velorki.com      the site, the docs, /s/<id> share pages
#   www.velorki.com  308 to the apex
#   api.velorki.com  the relay (OAuth exchange, /ai/plan, POST /share, /health)
#
# The app separates the two roles by the Host header (SITE_HOST / API_HOST), so
# `header_up Host {host}` below is load-bearing: strip it and every request
# arrives as `127.0.0.1:8080`, which the app reads as the api role (that is how
# Orkify's header-less health probe reaches /health). The site would then be
# unreachable and the relay would answer on every hostname.
#
# TLS is a Cloudflare Origin CA certificate (not ACME): it is only trusted by
# Cloudflare, which is the only thing allowed to reach this box. Cloudflare runs
# Full (strict) against it. One certificate covers all three names
# (velorki.com + *.velorki.com).

{
	# Cloudflare is the only client, so its addresses are the only proxies whose
	# forwarding headers may be believed. /etc/caddy/cloudflare-ips.caddy is
	# generated by deploy/web/cloudflare-ips.sh from cloudflare.com/ips-v4 and
	# ips-v6 and refreshed by cron; it contains exactly one line:
	#   trusted_proxies static <cidr> <cidr> ...
	servers {
		import /etc/caddy/cloudflare-ips.caddy

		# Take the client IP from Cloudflare's own header rather than
		# X-Forwarded-For. Combined with trusted_proxies above and the ufw rules
		# that only let Cloudflare in, it cannot be forged.
		client_ip_headers CF-Connecting-IP

		# Refuse to fall back to the remote address when the header chain does
		# not come from a trusted proxy: a direct hit (which should be
		# impossible) must not look like a real client.
		trusted_proxies_strict
	}

	# No ACME: the certificate is issued by Cloudflare's Origin CA and installed
	# by hand. Nothing here should ever try to talk to Let's Encrypt.
	auto_https disable_redirects
}

# Shared upstream settings. `import proxy_to_app` in each site block.
(proxy_to_app) {
	reverse_proxy 127.0.0.1:8080 {
		# The app routes by Host. Caddy would otherwise send the upstream
		# address.
		header_up Host {host}
		# Real client address for the app's rate limiter
		# (CLIENT_IP_HEADER=cf-connecting-ip). {client_ip} is resolved from
		# client_ip_headers above, so this is Cloudflare's value, re-emitted
		# after Caddy has validated where it came from.
		header_up CF-Connecting-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}

		transport http {
			dial_timeout 5s
			# No response_header_timeout / read_timeout: POST /ai/plan is an
			# SSE stream that stays open for minutes. Caddy's defaults are
			# unlimited, which is what a stream needs.
			write_timeout 0
		}
		# Never buffer: SSE must reach the client byte by byte.
		flush_interval -1
	}
}

(logging) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

# ----------------------------------------------------------------- apex ---
velorki.com {
	tls /etc/caddy/certs/velorki.com.pem /etc/caddy/certs/velorki.com.key

	# zstd first: Cloudflare and every current browser take it.
	encode zstd gzip

	import proxy_to_app
	import logging
}

# ------------------------------------------------------------------ www ---
www.velorki.com {
	tls /etc/caddy/certs/velorki.com.pem /etc/caddy/certs/velorki.com.key

	# One canonical origin for the site, share links and the CSP. 308 keeps the
	# method and body, which matters for nothing here but costs nothing.
	redir https://velorki.com{uri} 308

	import logging
}

# ------------------------------------------------------------------ api ---
api.velorki.com {
	tls /etc/caddy/certs/velorki.com.pem /etc/caddy/certs/velorki.com.key

	encode zstd gzip

	# Hard ceiling in front of the app's own limits (1 MB default, 3 MB for
	# POST /share). Caddy rejects anything larger with 413 before a byte
	# reaches Node.
	request_body {
		max_size 4MB
	}

	import proxy_to_app
	import logging
}

# --- Authenticated Origin Pulls (optional, see docs/DEPLOY_WEB.md step 5) ---
# Makes Cloudflare prove it is Cloudflare with a client certificate, so the
# origin is unreachable even if someone learns its address and spoofs a range.
# Download the CA once:
#   curl -fsSL https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem \
#     | sudo tee /etc/caddy/certs/cloudflare-origin-pull-ca.pem
# then enable "Authenticated Origin Pulls" in the Cloudflare dashboard and add
# this block inside EACH site's `tls` directive (turn the one-liner into a
# block):
#
#   tls /etc/caddy/certs/velorki.com.pem /etc/caddy/certs/velorki.com.key {
#       client_auth {
#           mode require_and_verify
#           trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
#       }
#   }
#
# Enable it in Cloudflare BEFORE Caddy, or the first reload locks the site out.
