# Velorki self-hosting configuration.
# Copy to .env and edit:   cp .env.example .env
# .env is read by docker compose for substitution AND passed to the api
# service via env_file, so keep secrets out of version control.

# ---------------------------------------------------------------- core ---

# Public hostname Caddy serves and requests a certificate for.
# Must already resolve to this machine's public IP.
DOMAIN=velorki.example.com

# Address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------- brouter ---

# Upstream BRouter git tag. Used as the build arg for the brouter image, as
# the image tag, and as a fallback value in manifest.json.
# Bump it, then: docker compose build brouter && docker compose up -d brouter
BROUTER_VERSION=v1.7.10

# Which segment tiles to mirror. Space-separated globs against tile names
# (the .rd5 is implied).
#   *                       whole planet - 1142 tiles, ~9.3 GB (Sep 2026)
#   E*_N4* E*_N5* W*_N5*    Europe        -  224 tiles, ~3.0 GB
#   E5_N45                  a single tile (Switzerland), for a smoke test
SEGMENT_FILTER=*

# How long brouter-updater sleeps between passes. Suffixes: d, h, m, s.
# brouter.de rebuilds nightly; weekly is plenty and stays polite.
SYNC_INTERVAL=7d

# Where to mirror from. Only change this if you run your own segment mirror.
#SEGMENTS_URL=https://brouter.de/brouter/segments4/

# Set to 1 to record a sha256 per tile in manifest.json. Off by default:
# hashing ~9 GB every pass costs minutes of CPU and buys little, since each
# tile is already size-checked against the index before being installed.
#MANIFEST_SHA256=0

# JVM flags for the routing server. 512 MB is comfortable for the planet set.
#JAVA_OPTS=-Xmx512M

# ----------------------------------------------------------------- api ---

# Tag for the prebuilt API image. Only used if you switch the api service in
# docker-compose.yml from `build:` to `image:`.
API_TAG=latest

# --- API (only if running api via compose) -------------------------------
# These are consumed by the Velorki API itself, not by the compose stack. If
# you run the API with Orkify as a plain Node process (as the official VPS
# does), set them in that process' environment instead - see README.md.
# Leave them unset here if you are only self-hosting BRouter.

# PUBLIC_BASE_URL           Absolute origin the API builds share/OAuth URLs from, e.g. https://velorki.example.com
# STRAVA_CLIENT_ID          Strava API application client id, for ride import
# STRAVA_CLIENT_SECRET      Strava API application client secret - secret
# RWGPS_CLIENT_ID           Ride with GPS API client id, for route import
# RWGPS_CLIENT_SECRET       Ride with GPS API client secret - secret
# OAUTH_REDIRECT_ALLOWLIST  Comma-separated redirect URIs accepted after OAuth, incl. the app's custom scheme
# REVENUECAT_SECRET_KEY     RevenueCat v2 secret API key used to verify subscriptions - secret
# REVENUECAT_ENTITLEMENT    Entitlement id that unlocks paid features (default: plus)
# REVENUECAT_MODE           live = call RevenueCat; stub = treat everyone as entitled (local dev only)
# LLM_BASE_URL              OpenAI-compatible base URL for the route-description assistant
# LLM_API_KEY               API key for that endpoint - secret
# LLM_MODEL                 Model id to request, e.g. claude-sonnet-4-6
# LLM_DAILY_BUDGET_USD      Hard daily spend cap; the assistant is disabled once exceeded
# SHARE_DB_PATH             SQLite file for share links, inside the api_data volume, e.g. /app/data/share.db

#PUBLIC_BASE_URL=https://velorki.example.com
#STRAVA_CLIENT_ID=
#STRAVA_CLIENT_SECRET=
#RWGPS_CLIENT_ID=
#RWGPS_CLIENT_SECRET=
#OAUTH_REDIRECT_ALLOWLIST=velorki://oauth/callback,https://velorki.example.com/oauth/callback
#REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=plus
REVENUECAT_MODE=live
#LLM_BASE_URL=
#LLM_API_KEY=
#LLM_MODEL=
#LLM_DAILY_BUDGET_USD=5
SHARE_DB_PATH=/app/data/share.db
