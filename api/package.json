{
  "name": "@velorki/api",
  "version": "1.0.0",
  "private": true,
  "description": "Velorki relay service: entitlement check, OAuth token exchange, AI route planning and share links.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.48",
    "ai": "^7.0.99",
    "fastify": "^5.12.4",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
