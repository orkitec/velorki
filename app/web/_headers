# Cloudflare Pages response headers for the web build (app.velorki.com).
# flutter build web copies this file into build/web. A request gets the
# headers of every rule its path matches; a header set by two rules is
# joined with a comma, so Cache-Control is only ever set by one rule per path.
# Responses from the /tiles/ Pages Function set their own headers.

# Cross-origin isolation (SharedArrayBuffer: the multi-threaded renderer and
# drift on OPFS) comes from Document-Isolation-Policy, not from COOP
# same-origin + COEP: the Google and Apple sign-in popups (Settings → Sync
# with) post their answer back to this page, which COOP same-origin cuts off
# (the popup loses its opener). So COOP is same-origin-allow-popups and
# Chrome isolates the page by Document-Isolation-Policy
# (isolate-and-credentialless: other origins' map tiles, fonts and weather
# images load without credentials, as COEP credentialless did). A browser
# without it (Firefox, Safari) runs the page without isolation:
# single-threaded renderer, drift on IndexedDB.
#
# The Content-Security-Policy names exactly what the app loads. Its own
# origin: the page, the engine (built with --no-web-resources-cdn),
# maplibre-gl-js and SQLite (tool/web_assets.sh) and the routing tiles
# (/tiles/). Elsewhere: the base map (OpenFreeMap), place search (Photon),
# the online cycle map (CyclOSM), the relay (api.velorki.com: BRouter, the
# relay's radars), the free weather layers (the hosts of
# defaultWeatherMapSources in lib/features/map/domain/weather_map.dart), and
# the engine's fallback fonts for scripts the app's own fonts lack
# (fonts.gstatic.com). blob: for maplibre's worker and the cycle map's
# GeoJSON, data: for the images maplibre decodes; 'wasm-unsafe-eval' to
# compile the app and SQLite. A new host the app talks to goes in here too.
#
# Sync (lib/features/sync): Google Identity Services, the hosts Google
# documents for it (accounts.google.com/gsi/: the script, its button's
# iframe, its stylesheet and its status calls), and Drive v3 on
# www.googleapis.com; CloudKit JS from Apple's CDN (cdn.apple-cloudkit.com,
# which Apple's licence requires it be loaded from), CloudKit Web Services
# (api.apple-cloudkit.com) and the asset hosts records' bodies go up to and
# come down from (*.icloud-content.com, *.icloud.com). The sign-in pages
# themselves (accounts.google.com, idmsa.apple.com) open in popups, which
# this policy does not govern. CloudKit JS's error statistics
# (feedbackws.*) stay blocked.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Document-Isolation-Policy: isolate-and-credentialless
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client https://cdn.apple-cloudkit.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://tiles.openfreemap.org https://*.tile-cyclosm.openstreetmap.fr; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://tiles.openfreemap.org https://photon.komoot.io https://api.openstreetmap.org https://api.velorki.com https://*.tile-cyclosm.openstreetmap.fr https://fonts.gstatic.com https://maps.dwd.de https://geoservices.knmi.nl https://openwms.fmi.fi https://mapservices.weather.noaa.gov https://view.eumetsat.int https://mesonet.agron.iastate.edu https://gibs.earthdata.nasa.gov https://accounts.google.com/gsi/ https://www.googleapis.com https://api.apple-cloudkit.com https://*.icloud-content.com https://*.icloud.com; manifest-src 'self'; object-src 'none'; frame-src https://accounts.google.com/gsi/; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Entry points: always revalidated, so a deploy is picked up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

# The rest of the build. Flutter does not content-hash these names, so they
# cannot be immutable: an hour, then revalidated.
/assets/*
  Cache-Control: public, max-age=3600
/canvaskit/*
  Cache-Control: public, max-age=3600
/flutter.js
  Cache-Control: public, max-age=3600
/main.dart.wasm
  Cache-Control: public, max-age=3600
/main.dart.mjs
  Cache-Control: public, max-age=3600
/main.dart.js
  Cache-Control: public, max-age=3600
/sqlite3.wasm
  Cache-Control: public, max-age=3600
/drift_worker.js
  Cache-Control: public, max-age=3600
/maplibre-gl/*
  Cache-Control: public, max-age=3600
/boot.mjs
  Cache-Control: no-cache
/device_gate.mjs
  Cache-Control: no-cache
