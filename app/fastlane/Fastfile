# Velorki release lanes, Android only. iOS is built, signed and uploaded by
# xcodebuild with automatic signing; see docs/RELEASE_IOS.md. Nothing here
# creates accounts or store entries — see fastlane/README.md for what has to be
# set up by hand first.
#
# All paths are derived from this file's location, so a lane behaves the same
# whatever directory it is invoked from.

APP_DIR      = File.expand_path("..", __dir__)            # app/
ANDROID_DIR  = File.join(APP_DIR, "android")
AAB_PATH     = File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab")
# dart-defines for the release build. `env/prod.json` is not committed; it is
# restored from a secret in CI (see .github/workflows/release.yml) and kept in
# the password manager otherwise.
ENV_FILE     = ENV["VELORKI_ENV_FILE"] || File.join(APP_DIR, "env/prod.json")

default_platform(:android)

# Flutter's Gradle plugin reads --dart-define values from the `dart-defines`
# Gradle property: a comma-separated list of individually base64-encoded
# "KEY=value" pairs. This turns env/prod.json into that list so a Gradle build
# carries the same configuration as `flutter build --dart-define-from-file`.
def dart_defines_property
  require "json"
  require "base64"
  UI.user_error!("Missing #{ENV_FILE}") unless File.exist?(ENV_FILE)
  JSON.parse(File.read(ENV_FILE))
      .map { |key, value| Base64.strict_encode64("#{key}=#{value}") }
      .join(",")
end

platform :android do
  desc "Build a signed AAB and upload it to the Play internal testing track"
  lane :internal do
    UI.user_error!("Set PLAY_SERVICE_ACCOUNT_JSON_PATH") if ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"].to_s.empty?
    UI.user_error!("android/key.properties is missing (upload keystore)") unless File.exist?(File.join(ANDROID_DIR, "key.properties"))

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: ANDROID_DIR,
      properties: {
        "dart-defines" => dart_defines_property,
        # Play rejects a build number it has already seen; CI passes its run
        # number, a local build falls back to the pubspec's.
        "version-code" => ENV["BUILD_NUMBER"],
      }.compact,
    )

    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      json_key: ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"],
      release_status: "completed",
      # The listing is still written by hand in the Play Console; turn these
      # off once fastlane/metadata/android is the source of truth.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Promote the newest internal build to the closed test track"
  lane :promote_closed do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha",
      json_key: ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end
