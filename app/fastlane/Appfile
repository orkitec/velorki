# Identities fastlane signs and uploads with.
#
# Everything secret comes from the environment, so this file is safe to commit
# and a fork can point it at its own accounts without editing Ruby:
#
#   PLAY_SERVICE_ACCOUNT_JSON_PATH  path to the Play service account JSON
#
# iOS does not go through fastlane; see docs/RELEASE_IOS.md.

for_platform :android do
  package_name(ENV["ANDROID_PACKAGE_NAME"] || "com.orkitec.velorki")
  json_key_file(ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"])
end
