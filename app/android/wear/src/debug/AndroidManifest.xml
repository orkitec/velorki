    <application>
        <receiver
            android:name=".DebugFeedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.orkitec.velorki.wear.debug.FEED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
