<?xml version="1.0" encoding="utf-8"?>
<!-- Referenced from AndroidManifest.xml (android:dataExtractionRules).

     Android 12 and newer apply android:allowBackup only to cloud backup;
     device-to-device transfer is governed by this file. Velorki keeps rides,
     routes and OAuth tokens on the device it recorded them on, so both
     channels exclude every domain. An empty <cloud-backup/> or
     <device-transfer/> element would mean "copy everything", so the excludes
     have to be spelled out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
