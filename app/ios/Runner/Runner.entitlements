<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.orkitec.velorki</string>
	</array>
	<!-- Universal Links for share pages: https://velorki.com/s/<id> opens the
	     app instead of Safari. The website serves
	     /.well-known/apple-app-site-association from its APPLE_TEAM_ID
	     setting; Associated Domains must also be enabled for the app id in
	     the developer portal (docs/OPEN_ITEMS.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:velorki.com</string>
	</array>
</dict>
</plist>
