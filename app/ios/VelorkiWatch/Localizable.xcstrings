    "The phone did not answer. Open Velorki on the phone and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Handy antwortet nicht. Öffne Velorki auf dem Handy und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono no responde. Abre Velorki en el teléfono y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone ne répond pas. Ouvrez Velorki sur le téléphone et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono non risponde. Apri Velorki sul telefono e riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De telefoon reageert niet. Open Velorki op de telefoon en probeer het opnieuw."
          }
        }
      }
    },
    "The watch would not start a workout: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhr konnte kein Training starten: %@"
          }
