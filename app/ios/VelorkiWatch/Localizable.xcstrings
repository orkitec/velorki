{
  "sourceLanguage" : "en",
  "strings" : {
    "Finish" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden"
          }
        }
      }
    },
    "Finish opens the save sheet on the phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach „Beenden“ speicherst du die Fahrt auf dem Handy."
          }
        }
      }
    },
    "Health access is needed: allow it on the watch or in the phone's Health app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velorki braucht Zugriff auf Health: Erlaube ihn auf der Uhr oder in der Health-App des Handys."
          }
        }
      }
    },
    "Low Power Mode in the watch's settings makes a long ride last." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Stromsparmodus in den Einstellungen der Uhr hält der Akku auch eine lange Fahrt durch."
          }
        }
      }
    },
    "Pause" : {
