{
  "sourceLanguage" : "en",
  "strings" : {
    "Finish" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beëindigen"
          }
        }
      }
    },
    "Finish opens the save sheet on the phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach „Beenden“ speicherst du die Fahrt auf dem Handy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras «Terminar», guardas la salida en el teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après « Terminer », enregistrez la sortie sur le téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo «Termina» salvi il giro sul telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ‘Beëindigen’ sla je de rit op de telefoon op."
          }
        }
      }
    },
    "Health access is needed: allow it on the watch or in the phone's Health app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velorki braucht Zugriff auf Health: Erlaube ihn auf der Uhr oder in der Health-App des Handys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velorki necesita acceso a Salud: permítelo en el reloj o en la app Salud del teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velorki a besoin d’accéder à Santé : autorisez-le sur la montre ou dans l’app Santé du téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velorki ha bisogno dell'accesso a Salute: consentilo sull'orologio o nell'app Salute del telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velorki heeft toegang tot Gezondheid nodig: sta die toe op het horloge of in de Gezondheid-app van de telefoon."
          }
        }
      }
    },
    "Low Power Mode in the watch's settings makes a long ride last." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Stromsparmodus in den Einstellungen der Uhr hält der Akku auch eine lange Fahrt durch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el modo de bajo consumo en los ajustes del reloj, la batería aguanta una salida larga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le mode économie d’énergie, dans les réglages de la montre, la batterie tient toute une longue sortie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la modalità risparmio energetico nelle impostazioni dell'orologio, la batteria regge un giro lungo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de energiebesparingsmodus in de instellingen van het horloge houdt de batterij een lange rit vol."
          }
        }
      }
    },
