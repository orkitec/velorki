# fastlane and its dependencies. Bundler looks for the Gemfile in the
# directory fastlane runs from, which is `app/`, one level above
# `app/fastlane/`.
#
#   cd app && bundle install && bundle exec fastlane android internal
source "https://rubygems.org"

# 2.241.1 is the first deliver that knows the iPhone Duo's 2853x2007 (2.230
# the 13" iPad's 2064x2752). The App Store's creative assets (the product
# page header and the search results image) need fastlane/fastlane#30442;
# its branch is on 2.241.0, which refuses the Duo's screenshots, so it is not
# pinned: the Fastfile skips the creative assets until a release has them.
gem "fastlane", "~> 2.241", ">= 2.241.1"
