# fastlane and its dependencies. Bundler looks for the Gemfile in the
# directory fastlane runs from, which is `app/`, one level above
# `app/fastlane/`.
#
#   cd app && bundle install && bundle exec fastlane android internal
source "https://rubygems.org"

# 2.241.1 is the first deliver that knows the iPhone Duo's 2853x2007 (2.230
# the 13" iPad's 2064x2752).
# fastlane from the pull request that teaches deliver the App Store's creative
# assets (the product page header and the search results image; iOS 27),
# fastlane/fastlane#30442, pinned to its commit until it is released. Then:
#   gem "fastlane", "~> 2.242"
gem "fastlane", git: "https://github.com/techiro/fastlane.git", ref: "6af3a362df0745a5bf84f5da2db395a43d9bc9cd"
