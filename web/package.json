{
  "name": "@velorki/web",
  "version": "1.0.0",
  "private": true,
  "description": "Velorki website and relay: velorki.com and api.velorki.com in one Next.js app.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build-info": "node scripts/build-info.mjs",
    "postbuild": "node scripts/standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "start:cluster": "PORT=8080 orkify run .next/standalone/server.js --name velorki-web --workers 2 --health-check /health --kill-timeout 15000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "node scripts/check-deps.mjs",
    "locales": "node scripts/gen-locales.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.60",
    "@orkify/cache": "^1.0.0",
    "@orkify/chat": "^1.0.0",
    "@orkify/next": "^1.0.0",
    "ai": "^7.0.123",
    "gray-matter": "^4.0.3",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@orkify/cli": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
