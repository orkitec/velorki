# Velorki web - environment.
# Copy to .env.local for local development (every .env* but this file is
# gitignored). In production Orkify injects these straight into process.env;
# the app does not read a .env file itself.
#
# Every integration is optional. When its variables are missing the matching
# routes answer 503 `unavailable` instead of the app refusing to boot.
#
# PORT and HOSTNAME are not listed below because nothing in this app reads
# them: Next's standalone server does, straight from the environment. In
# production they come from the `env:` block in orkify.yml (8080 / 0.0.0.0,
# matching that file's `port:`); locally `next dev` defaults to 3000.
#
# The NEXT_PUBLIC_* variables are different from everything else here: Next
# inlines them into the build output, so they are fixed when `npm run build`
# runs and changing them afterwards has no effect until the next build.

# ---------------------------------------------------------------- server ----

# pino level: fatal | error | warn | info | debug | trace | silent. Default: info.
LOG_LEVEL=info

# Reported by GET /health as `version`. Default: dev. Set it to the build tag.
APP_VERSION=dev

# Origin used to build share links (`${PUBLIC_BASE_URL}/s/<id>`), i.e. the site
# host, not the API host. No trailing slash. Default: https://velorki.com.
PUBLIC_BASE_URL=https://velorki.com

# Set to 1 only when a trusted reverse proxy sits in front of this app.
# It makes X-Forwarded-For - and CLIENT_IP_HEADER below - authoritative for
# rate-limit keys; leave it unset when the app is reachable directly, or
# clients can forge their own IP. With it unset every caller shares the key
# "unknown", whatever headers they send.
TRUST_PROXY=0

# ----------------------------------------------------------------- hosts ----

# The API is served on this host and nowhere else. Default: api.velorki.com.
API_HOST=api.velorki.com

# The website and the share pages are served on this host and nowhere else.
# Default: velorki.com. Any other Host header answers 404 before a handler runs.
# A loopback Host (localhost, 127.0.0.1, ::1) is always the API role so
# Orkify's health probe, which cannot set a Host header, reaches /health.
SITE_HOST=velorki.com

# Set to 1 for local development: one origin then plays both roles. The API
# role is reached at api.localhost:3000, under the /__api/* prefix, or with the
# header `X-Velorki-Host: api`; plain localhost is the site. Default: off.
DEV_HOSTS=0

# Header carrying the real client IP, used as the rate-limit key. Behind
# Cloudflare that is cf-connecting-ip; the edge overwrites it and the origin
# firewall makes it unforgeable. Only read when TRUST_PROXY=1 - on its own it
# would let any caller pick a bucket - and unset it falls back to
# X-Forwarded-For. Commented out here because this file's TRUST_PROXY is 0;
# deploy/web/velorki-web.env.example is the production pair.
#CLIENT_IP_HEADER=cf-connecting-ip

# -------------------------------------------------------------- counters ----

# Where the cross-worker counters live: orkify | memory.
#   orkify - @orkify/cache, shared by every worker of the cluster.
#   memory - process-local; correct for `next dev` and for a single worker.
# Default: orkify when ORKIFY_EXEC_MODE is set (i.e. under orkify), else memory.
# They hold the rate-limit windows, the entitlement cache, the daily AI spend
# and the share-sweep election - nothing that must survive a restart.
COUNTERS=orkify

# --------------------------------------------------------------- routing ----

# Base URL of a BRouter instance, without a trailing slash. Only used for the
# health probe; the app itself talks to BRouter directly.
# Unset -> /health reports brouter: "unconfigured".
BROUTER_URL=https://brouter.example.org

# ------------------------------------------------------------------ OAuth ----

# Strava API application credentials (https://www.strava.com/settings/api).
# Unset -> /oauth/strava/* returns 503 unavailable.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Ride with GPS API credentials. Unset -> /oauth/rwgps/* returns 503 unavailable.
RWGPS_CLIENT_ID=
RWGPS_CLIENT_SECRET=

# Comma-separated list of redirect URIs the app is allowed to use. Matching is
# exact - no prefixes, no wildcards. An empty list rejects every token exchange.
OAUTH_REDIRECT_ALLOWLIST=velorki://oauth/strava,velorki://oauth/rwgps

# Keys the relay wraps service tokens with before handing them to the phone
# (AES-256-GCM). Comma-separated `kid:base64key` entries: the first wraps, all
# of them unwrap, which is how a key is rotated - put the new one in front,
# keep the old one until every phone has been re-wrapped by a pass-through
# call, then drop it. A kid is [A-Za-z0-9_-]{1,32}; a key is 32 random bytes:
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
# Unset -> /oauth/*/token, /oauth/strava/refresh and /proxy/* return 503
# unavailable, like a missing client secret.
TOKEN_WRAP_KEYS=

# ------------------------------------------------------------ entitlement ----

# RevenueCat v1 secret API key. Required when REVENUECAT_MODE=live.
REVENUECAT_SECRET_KEY=

# Entitlement identifier to look for on the subscriber. Default: plus.
REVENUECAT_ENTITLEMENT=plus

# live | stub. Default: live.
#   live - every request is verified against the RevenueCat API.
#   stub - everyone is entitled. For forks and local development ONLY; it
#          disables paywall enforcement completely.
REVENUECAT_MODE=live

# -------------------------------------------------------------------- LLM ----

# Any OpenAI-compatible chat completions endpoint (the /v1 root), e.g. a
# self-hosted llama.cpp or vLLM server, or a hosted provider.
# Unset -> /ai/plan returns 503 and /health reports llm: "unconfigured".
LLM_BASE_URL=

# Sent as `Authorization: Bearer <key>`. Optional: self-hosted servers often
# do not need one.
LLM_API_KEY=

# Model identifier as the endpoint knows it.
LLM_MODEL=

# Global circuit breaker on spend, in USD per UTC day, counted across the
# cluster. Unset = no limit. Over budget, /ai/plan answers 503 unavailable
# until the next UTC midnight. The hard ceiling belongs at the provider.
# Setting it requires both prices below to be greater than 0 - otherwise the
# estimated spend is always 0 and the budget would never apply. The app
# refuses to start in that case rather than pretend it has a cap.
LLM_DAILY_BUDGET_USD=

# Token prices used to estimate that spend, in USD per 1000 tokens.
# Both default to 0, i.e. no spend is counted and no budget may be set.
LLM_USD_PER_1K_IN=0
LLM_USD_PER_1K_OUT=0

# ------------------------------------------------------------------ share ----

# SQLite file for shared routes and rides (node:sqlite, WAL mode).
# The parent directory is created at startup. Default: ./data/share.sqlite.
# In production this must be an absolute path on a persistent volume, outside
# the release tree, or every deploy breaks every share link handed out.
SHARE_DB_PATH=./data/share.sqlite

# ----------------------------------------------------------- app linking ----

# Apple Developer team id. With it, /.well-known/apple-app-site-association is
# served and iOS opens https://velorki.com/s/<id> in the app.
# Unset -> that file 404s, so an unconfigured deployment advertises nothing.
APPLE_TEAM_ID=

# SHA-256 signing certificate fingerprints for com.orkitec.velorki, colon
# separated, several allowed as a comma-separated list (upload key and Play
# app-signing key). With it, /.well-known/assetlinks.json is served.
# Unset -> that file 404s.
ANDROID_CERT_SHA256=

# ------------------------------------------------------------ website ----

# Absolute origin of the public website, no trailing slash. Build-time: it is
# baked into canonical links, hreflang, the sitemap, robots.txt, the JSON-LD
# and the Open Graph tags, none of which may depend on a request header.
# Default: https://velorki.com.
NEXT_PUBLIC_SITE_URL=https://velorki.com

# Store listing URLs, used by the download page and the badges. Build-time.
# Empty is a valid answer and the honest one until a listing exists: a badge
# with no URL is left out of the markup entirely rather than rendered dead.
NEXT_PUBLIC_STORE_URL_IOS=
NEXT_PUBLIC_STORE_URL_ANDROID=

# ---------------------------------------------------------------- orkify ----

# Set by Orkify, not by hand. ORKIFY_EXEC_MODE decides the COUNTERS default;
# ORKIFY_WORKER_ID names the worker in every log line and elects worker "0" to
# run the daily share sweep.
# ORKIFY_EXEC_MODE=
# ORKIFY_WORKER_ID=
